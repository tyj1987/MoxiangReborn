# Git LFS (Large File Storage) tracking rules.
#
# 2026-09-08: the 2008 墨香 client PlayDH tree has 4 .pak archives
# that exceed GitHub's 100 MB per-file limit:
#   modern/data/PlayDH/Map.pak        557.24 MB
#   modern/data/PlayDH/Character.pak  239.56 MB
#   modern/data/PlayDH/Effect.pak     207.32 MB
#   modern/data/PlayDH/monster.pak    167.04 MB
# These four files are routed through Git LFS so the canonical 1:1
# resource reference can live in this repository without violating
# the 100 MB cap.  All other PlayDH resources (3 369 smaller
# files, 1 126 MB total) are tracked as plain git blobs.

# Keep every PlayDH byte intact across Windows checkouts. The four LFS
# archives retain their specific filter rules below.
modern/data/PlayDH/** -text

# This historical deployment script has mixed line endings in the Git blob.
# Keep unchanged lines byte-identical when updating its schema contract.
deploy/database/mx_modern_schema_mssql.sql -text

modern/data/PlayDH/Map.pak filter=lfs diff=lfs merge=lfs -text
modern/data/PlayDH/Character.pak filter=lfs diff=lfs merge=lfs -text
modern/data/PlayDH/Effect.pak filter=lfs diff=lfs merge=lfs -text
modern/data/PlayDH/monster.pak filter=lfs diff=lfs merge=lfs -text

# Supplemental original-layout pak (reference/manifests/playdh-supplemental-fill.json,
# built by modern/tools/pak_writer.py). Expected well under 50 MB, so it is a
# plain blob covered by the PlayDH -text rule above. If it ever reaches 50 MB,
# add: modern/data/PlayDH/zz_supplement.pak filter=lfs diff=lfs merge=lfs -text
