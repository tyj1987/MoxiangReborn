# Phase 10.24: MoxianProtocolDoc --summary build artifact.
# The C++ tool (modern/tools/MoxianProtocolDoc/main.cpp) writes
# "Protocol Summary: ..." block to stdout when called with --summary.
# Some sessions accidentally redirected that stdout into
# docs/MoxianProtocolDoc_summary.txt as a build artifact. The
# source-of-truth is docs/MoxianProtocolDoc.md (auto-generated by
# modern/tools/gen_protocol_doc.py), so the summary dump is redundant.
docs/MoxianProtocolDoc_summary.txt

# MSBuild full logs (non-deterministic /MP ordering + CRLF on Windows;
# regenerate on demand with build_*.py)
modern/scripts/build_*_full.txt
modern/build_*_log.txt

# Mavis / planning scratch (session metadata, never source-of-truth)
.mavis/
plan_launch.txt
roster.txt
*plan_decision*.json


# Allow our log module (was matching Log/ rule)
!modern/src/log/
!modern/include/mxh/log/

# Phase A.1.5 — `include/mxh/ui/` is a junction to `src/ui/` (UI headers
# physically live in `src/ui/` but `CMakeLists.txt` and `#include` paths
# reference them under `mxh/ui/`).  Tracking the junction contents
# would double-add every UI file, so we ignore the junction's view.
modern/include/mxh/ui/

# Phase A.1 — manual build helpers (bypass cmake when not available).
# Tracked in scratch for the rare case the user wants to build without
# a fresh cmake configure.  See `modern/scratch/compile_mxh_client.bat`
# for the bypass recipe.
!modern/scratch/compile_mxh_client.bat
!modern/scratch/build_client_lib.bat
!modern/scratch/build_client_tests.bat
!modern/scratch/rebuild_mxh_ui.bat
!modern/scratch/stub_search.cpp

# Phase 7.5p — agent probe binaries (one-off size/layout/HSEL smoke probes)
modern/scripts/probe_artifacts/

# Phase 7.5p — agent scratch dir (desktop + session leftover archives)
# Subdirs named `<source>_<YYYY-MM-DD>/` are ad-hoc agent scratch archives.
# Not source-of-truth; safe to `mavis-trash` any time.
# Only the archive subdirs are ignored — root-level files (e.g. tools
# referenced by MODERNIZATION_PLAN 复现命令) are tracked normally.
modern/scratch/_archive_*/
!modern/scratch/*.py
!modern/scratch/*.md
# Runtime logs from running server tools in the scratch dir (login_handler,
# MoxianLoginServer main, etc.) — these are session-ephemeral, not
# source-of-truth. The .py / .md exceptions above still allow root-level
# tools and the README to be tracked.
modern/scratch/*.log
# Phase B E2E smoke test artifacts: SQLite DBs and per-server log files
# written by verify_servers_e2e.py under modern/scratch/e2e_*/. The script
# auto-cleans on success; on failure use --keep-on-fail to inspect.
modern/scratch/e2e_*/

# Phase 10.4 — agent tool directories and session leftovers.
# These are dev-environment state, not source-of-truth. They contain
# editor state, IDE config, runtime caches, and SQL Server installer
# binaries. Mavis-side; never commit.
.mimocode/
.qoder/
.qoder-work/
.github-workflows-cache/
Testing/
plans/
AI_*.md
.agents/
*.iml
# GitHub workflows can land later via a dedicated PR if useful
.github/

# SQL Server Express installer (~300 MB) — too large for git, downloaded
# from Microsoft and installed via the docker/init-db/init.sh path.
SQLEXPR_x64_ENU/
SQLEXPR_*/

# deploy/ — legacy game content (binary, large, mirrored in SWorking/).
# Per AGENTS.md trap #1 "保持游戏内容 1:1", the game data lives in
# 墨香【源码】/SWorking/ and 墨香【源码配套资源】/. The deploy/ tree is
# just an alternate copy of that legacy data (binary .bin/.bmhm/.ttb +
# legacy 2008 .exe/.dll + game audio .wav). Git LFS would be the right
# tool for binary game data, but this repo is plain git. So:
#   - commit deploy/{DEPLOY_GUIDE.md, scripts/, database/, server/ServerSet/1/}
#     (operational + ~5 KB config)
#   - exclude the rest (binary blobs mirrored in SWorking/).
deploy/client/
deploy/server/Distribute/
deploy/server/Agent/
deploy/server/Map/
deploy/server/Monitoring/
deploy/server/RMTool/
# deploy/runtime/ per-process runtime data + logs from start_modern.ps1.
deploy/runtime/

# Whitelist: keep the operational deploy/ subdirectories (override above).
!deploy/DEPLOY_GUIDE.md
!deploy/scripts/
!deploy/database/
!deploy/server/ServerSet/

