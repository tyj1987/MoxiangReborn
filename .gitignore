# Local resource and reference payloads; manifests remain tracked.
# 2026-09-08: modern/data/PlayDH/ is now TRACKED for 1:1 resource
# alignment (see docs/RESOURCE_FORMATS.md and the 2026-09-08
# 1:1 verifier commit).  The tree is 1.76 GB across 5372 files
# (BMHM, TTB, BSAD, HFL, DDS, TIF, CHX, CHR, ANM, MOD, .pak
# mirrors) and is the canonical binary reference for every modern
# parser.  Local mirrors like 墨香【源码配套资源】\PlayDH\ still
# remain untracked below.
/modern/data/PlayDH/  # TRACKED — see comment above
/reference/*
!/reference/README.md
!/reference/manifests/
!/reference/manifests/**

# Local databases, logs and test output at repository roots.
/*.db
/*.db-*
/*.log
/*.out
/*.tmp
/Testing/
/unity_*.xml
/modern/backend=mssql_odbc;*

# Unity CLI can create a project-state mirror at the repository root when a
# caller starts from the wrong working directory. Keep that cache local; the
# canonical project lives under unity/MoxiangClient/.
/Library/
/Logs/
/Packages/
/ProjectSettings/
/UserSettings/

# Runtime secrets and local settings
*.env.local
*.secret
/.codex-local/
/modern/config/local/
/scripts/__pycache__/

