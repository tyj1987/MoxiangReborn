modern/build_INET/
modern/build_MHConsole/
modern/build_net32/
modern/build_inet/
modern/build_mhconsole/
modern/build_net32*/

# Agent / IDE editing scratch files.
modern/edit_*.py
modern/test_*output.txt
modern/test_*stderr.txt
modern/test_*stdout.txt
# Phase 10.4.10: build stdout logs for one-off map release / debug runs
modern/scripts/build_*.txt
# Phase 12.1: archive subdirs for build log roundups (e.g. build_logs_20260707/).
# Root README.md in the subdir is tracked; the .txt logs are not.
modern/scripts/build_logs_*/
# Phase 10.4.10: agent scratch helpers (incremental mod analysis, etc.)
modern/update_plan_*.py
~$*
*.bak
*.tmp
*.swp


# modern/scripts/ — byproducts of build scripts (NOT in git tracking)
# Real source files (.py/.cpp/.h/.json tools) are tracked; everything else here is output.
modern/scripts/*.log
modern/scripts/*_full.txt
modern/scripts/*_run.txt
modern/scripts/*_run*.txt
modern/scripts/stdout*.txt
modern/scripts/stderr*.txt
modern/scripts/run_demo_*.txt
modern/scripts/render_demo_*.txt
modern/scripts/verifier_*.txt
modern/scripts/build_*_attempt*.log
modern/scripts/_bak_*/
modern/scripts/*_commit_msg.txt
# Tracked exceptions (early phase commit msg templates): basenetwork/dbthread/net
# Untracked (ignored here): filestorage/hsel/phase75d
modern/scripts/plan_decision*.json

# Phase A.1 — The four `墨香【...】` directories at the repo root are
# the unmodified 2003-2010 source code + PlayDH resources + tutorial
# documents.  They are explicitly kept *outside* git tracking per
# AGENTS.md rule "原始源码（不动）"; the modern/ tree is the only
# commit target.  Listing them as ignored keeps `git status` from
# being a wall of 4,000 untracked entries.
墨香【客户端+服务端+工具】/
墨香【教程】/
墨香【源码】/
墨香【源码配套资源】/

# Phase A.1 — `modern/third_party/googletest-src/` is a vendored copy
# of GoogleTest that we patched (build flags, install layout).  We
# keep the upstream copy tracked upstream via a submodule in a future
# commit; for now, ignore the entire tree to avoid diff noise from
# vendor refreshes that don't affect the modern build.
modern/third_party/googletest-src/

# Phase A.1 — `build_map_detected_encoding.json` is a per-build
# cache from `setup-modern.ps1` (records the detected text encoding
# of each source file so cross-locale builds stay consistent).  It
# changes on every build and has no source-of-truth value.
modern/scripts/build_map_detected_encoding.json

# Phase A.1 — session-ephemeral artifacts from old agent runs.
# Kept on disk for forensic value but never tracked.
modern/docs/progress-video/
modern/scratch/progress_dashboard.html
modern/scratch/transfer_*/

# Phase 6 (2026-07-26) — alternate CMake build directories kept as
# working trees but never tracked (machine-local state).
modern/build2/
modern/build_check/
modern/build_vs/
modern/test_quick.txt

# Phase 6 (2026-07-26) — scratch directory holds session-ephemeral
# analysis + build helpers.  Per AGENTS.md, scratch files belong to
# `modern/scratch/<date>-<topic>/` and are not tracked.
modern/scratch/

# Phase 6 (2026-07-26) — top-level scratch scripts (debug + build
# wrappers) are session-only and should never enter the repo.
# Use scripts/ for anything that needs to persist.
/scratch_*.py
